<form autocomplete="off">
  <p class="notes">Connect this GM browser to the LoreBridge backend. Provider credentials remain on the backend.</p>
  <div class="form-group stacked">
    <label>Backend URL</label>
    <div class="form-fields"><input type="url" name="backendUrl" value="{{backendUrl}}" style="width:100%"></div>
    <p class="hint">Use a browser-accessible HTTPS URL. A loopback backend normally requires a reverse proxy.</p>
  </div>
  <fieldset>
    <legend>Connection</legend>
    <p><strong>Status:</strong> {{connectionStatus}}</p>
    {{#if backendId}}<p><strong>Backend ID:</strong> <code>{{backendId}}</code></p>{{/if}}
    {{#if fingerprint}}<p><strong>Fingerprint:</strong> <code>{{fingerprint}}</code></p>{{/if}}
    <p><strong>Paired:</strong> {{#if paired}}Yes{{else}}No{{/if}}</p>
  </fieldset>
  <div class="flexrow" style="gap:8px;margin-bottom:8px">
    <button type="button" data-action="check">Check Connection</button>
    {{#if paired}}<button type="button" data-action="unpair">Remove Local Pairing</button>{{else}}<button type="button" data-action="pair">Pair</button>{{/if}}
  </div>
  <footer class="sheet-footer flexrow"><button type="button" data-action="saveUrl">Save URL</button></footer>
</form>
