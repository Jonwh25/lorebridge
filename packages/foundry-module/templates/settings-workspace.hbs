<div class="lb-settings-workspace" style="display:flex;height:100%;overflow:hidden">
  {{!-- Nav rail --}}
  <nav class="lb-settings-nav" style="width:160px;flex-shrink:0;border-right:1px solid rgba(0,0,0,.2);overflow-y:auto;padding:8px 0">
    {{#each navItems}}
    <button
      type="button"
      data-action="nav"
      data-section="{{id}}"
      style="display:flex;align-items:center;gap:8px;width:100%;padding:9px 14px;background:{{#if active}}rgba(52,152,219,.18){{else}}transparent{{/if}};border:none;border-left:3px solid {{#if active}}#3498db{{else}}transparent{{/if}};cursor:pointer;text-align:left;font-size:0.85em;color:{{#if active}}#3498db{{else}}inherit{{/if}}">
      <i class="{{icon}}" style="width:16px;text-align:center"></i>
      {{label}}
    </button>
    {{/each}}
  </nav>

  {{!-- Section content --}}
  <div class="lb-settings-content" style="flex:1;overflow-y:auto;min-width:0">
    {{{sectionContent}}}
  </div>
</div>
